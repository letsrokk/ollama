<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_LAUNCH_AGENT_MANAGED_BY</key>
    <string>Managed by macos-install-launch-agent.sh.</string>
  </dict>

  <key>Label</key>
  <string>local.ollama.configured-launch</string>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>ProgramArguments</key>
  <array>
    <string>__OLLAMA_LAUNCH_SCRIPT__</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__OLLAMA_LAUNCH_STDOUT__</string>

  <key>StandardErrorPath</key>
  <string>__OLLAMA_LAUNCH_STDERR__</string>
</dict>
</plist>
